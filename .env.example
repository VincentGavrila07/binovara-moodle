# Build-time variables: used by Dockerfile while building the image.
PHP_VERSION=8.3
PHP_MEMORY_LIMIT=512M
MOODLE_IMAGE_TAG=local

# Runtime variables: passed by compose.yml to the running containers.
MOODLE_PORT=8080
# Change this when accessing Moodle via LAN/domain, e.g. http://192.168.100.14:8080.
MOODLE_WWWROOT=http://localhost:8080

DB_NAME=moodle_local
DB_USER=moodle_local
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=mdl_
